  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "bun-types": "^1.3.6",
    "tsx": "^4.23.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
